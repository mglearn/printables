{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mglearn.github.io/printables/substitute_packets/standards/standard.schema.json",
  "title": "TEKS standard record",
  "type": "object",
  "required": ["code", "display_code", "subject", "grade", "section", "source_url", "verified_on", "status"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string", "description": "Canonical code including TAC section, e.g. 112.27.b.8.A" },
    "display_code": { "type": "string", "description": "Short code teachers use, e.g. 7.8A" },
    "subject": { "type": "string", "enum": ["rla", "math", "science", "social", "elps"] },
    "grade": { "type": ["integer", "null"], "minimum": 3, "maximum": 12 },
    "course": { "type": ["string", "null"] },
    "section": { "type": "string", "description": "e.g. 19 TAC §112.27" },
    "strand": { "type": ["string", "null"] },
    "knowledge_statement": { "type": ["string", "null"] },
    "student_expectation": { "type": ["string", "null"], "description": "EXACT official wording, quoted from source_url. Null if not yet transcribed." },
    "focus": { "type": "string", "description": "Plain-language paraphrase of what the SE covers." },
    "adopted_year": { "type": ["integer", "null"] },
    "implementation_year": { "type": ["string", "null"] },
    "source_url": { "type": "string", "format": "uri" },
    "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["verified", "code-verified", "pending"],
      "description": "verified = code + exact official wording confirmed from source; code-verified = code/grade/subject confirmed against a cited source but official wording not yet transcribed; pending = not yet confirmed."
    },
    "notes": { "type": ["string", "null"] }
  }
}
